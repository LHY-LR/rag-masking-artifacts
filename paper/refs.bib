@inproceedings{bi2026parameters,
  title     = {Parameters vs.\ Context: Fine-Grained Control of Knowledge Reliance
               in Language Models},
  author    = {Bi, Baolong and Liu, Shenghua and Wang, Yiwei and Xu, Yilong and
               Fang, Junfeng and Mei, Lingrui and Cheng, Xueqi},
  booktitle = {International Conference on Learning Representations (ICLR 2026)},
  year      = {2026},
  note      = {arXiv:2503.15888. Records an {$\alpha$}-tunable decoder on {LLaMA3-8B}
               that moves memory recall of the {RAG} response from 9.9\% to 71.9\%
               (baseline 42.1\%) --- the closest prior work to the measurement
               problem we attack}
}

